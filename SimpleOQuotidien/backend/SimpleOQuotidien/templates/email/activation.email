{% load i18n %}

{% block subject %}
{% blocktrans %}Activez votre compte SimpleÔQuotidien {% endblocktrans %}
{% endblock subject %}

{% block text_body %}
Bonjour {{ user.first_name|default:user.username }},

Merci de vous être inscrit sur {{ site_name }}. 
Pour activer votre compte, rendez-vous à l'adresse suivante :
{{ protocol }}://{{ domain }}/{{ url|safe }}

Ce lien expire dans 1 heure.

L'équipe {{ site_name }}
{% endblock text_body %}

{% block html_body %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f4f6f9; padding: 40px 10px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" style="max-width: 560px; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.05);">
                    
                    <!-- En-tête Gradient -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #db2777 100%); padding: 40px 30px; text-align: center;">
                            <div style="font-size: 28px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px;">
                                SimpleÔQuotidien
                            </div>
                            <p style="color: rgba(255, 255, 255, 0.85); font-size: 14px; margin-top: 6px; margin-bottom: 0;">
                                Bienvenue parmi nous !
                            </p>
                        </td>
                    </tr>

                    <!-- Corps -->
                    <tr>
                        <td style="padding: 40px 35px; color: #334155; line-height: 1.6;">
                            <h1 style="font-size: 22px; font-weight: 700; color: #0f172a; margin-top: 0; margin-bottom: 16px; text-align: center;">
                                Activez votre compte 🚀
                            </h1>
                            
                            <p style="font-size: 15px; color: #475569; margin-bottom: 24px;">
                                Bonjour <strong style="color: #0f172a;">{{ user.first_name|default:user.username }}</strong>,
                            </p>
                            
                            <p style="font-size: 15px; color: #475569; margin-bottom: 32px;">
                                Merci de vous être inscrit sur <strong>SimpleÔQuotidien</strong>. Cliquez sur le bouton ci-dessous pour activer votre compte :
                            </p>

                            <!-- Bouton -->
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 32px;">
                                <tr>
                                    <td align="center">
                                        <a href="{{ protocol }}://{{ domain }}/{{ url|safe }}" target="_blank" style="display: inline-block; background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none; padding: 14px 36px; border-radius: 12px; box-shadow: 0 4px 12px rgba(124, 58, 237, 0.35);">
                                            Activer mon compte
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <div style="background-color: #f8fafc; border-left: 4px solid #6366f1; border-radius: 6px; padding: 14px 16px; margin-bottom: 24px;">
                                <p style="font-size: 13px; color: #64748b; margin: 0;">
                                    ⏳ <strong>Rappel :</strong> Ce lien est valide pendant <strong>24 heures</strong>.
                                </p>
                            </div>

                            <p style="font-size: 13px; color: #94a3b8; margin-bottom: 0;">
                                Si le bouton ne fonctionne pas, copiez ce lien :<br>
                                <a href="{{ protocol }}://{{ domain }}/{{ url|safe }}" style="color: #6366f1; word-break: break-all;">{{ protocol }}://{{ domain }}/{{ url|safe }}</a>
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="background-color: #f8fafc; padding: 24px 35px; text-align: center; border-top: 1px solid #f1f5f9;">
                            <p style="font-size: 12px; color: #94a3b8; margin: 0;">
                                © {% now "Y" %} {{ site_name }}. Tous droits réservés.
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
{% endblock html_body %}